---
import { telHref, smsHref } from '../data/site';
---
<nav aria-label="Quick help" class="mbar fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 gap-2 border-t border-line bg-white px-3 py-2.5 ph:hidden">
  <a href={telHref} data-track="call_click" class="mbar-btn bg-plum-900 text-white hover:text-white">Call</a>
  <a href={smsHref} data-track="text_click" class="mbar-btn bg-lavender-50 text-plum-900">Text</a>
  <a href="/care-match" class="mbar-btn bg-coral-400 text-plum-900">Care Match</a>
</nav>

<style>
  .mbar {
    box-shadow: 0 -6px 20px rgba(42, 30, 59, 0.1);
    /* clear the iPhone home indicator and side notches */
    padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));
    padding-left: max(0.75rem, env(safe-area-inset-left));
    padding-right: max(0.75rem, env(safe-area-inset-right));
  }
  /* Phone sideways: keep the bar but make it slimmer */
  @media (orientation: landscape) and (max-height: 30rem) {
    .mbar { padding-top: 0.375rem; padding-bottom: calc(0.375rem + env(safe-area-inset-bottom)); }
    .mbar-btn { min-height: var(--tap-min); }
  }
  .mbar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cta-min);
    border-radius: 0.875rem;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
</style>
