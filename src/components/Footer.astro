---
import { site, telHref } from '../data/site';
---
<footer class="bg-plum-950 px-0 pt-14 pb-10 text-on-dark">
  <div class="container-site flex flex-col gap-8">
    <div class="grid gap-8 text-base sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-2">
        <p class="font-heading text-[1.375rem] font-bold text-white">{site.name}</p>
        <p>{site.tagline}</p>
      </div>
      <nav aria-label="Care types" class="flex flex-col">
        <h2 class="font-sans text-base font-semibold text-white">Care</h2>
        <a class="footer-link" href="/care-options#assisted">Assisted Living</a>
        <a class="footer-link" href="/care-options#memory">Memory Care</a>
        <a class="footer-link" href="/care-options#ltc">Long-Term Care</a>
        <a class="footer-link" href="/areas">Areas We Serve</a>
      </nav>
      <nav aria-label="Company" class="flex flex-col">
        <h2 class="font-sans text-base font-semibold text-white">Company</h2>
        <a class="footer-link" href="/about">About &amp; Team</a>
        <a class="footer-link" href="/resources">Resources</a>
        <a class="footer-link" href="/how-it-works#faq">FAQ</a>
        <a class="footer-link" href="/about#partners">For Communities (partner with us)</a>
      </nav>
      <div class="flex flex-col">
        <h2 class="font-sans text-base font-semibold text-white">Contact</h2>
        <a class="footer-link" href={telHref} data-track="call_click">{site.phoneDisplay}</a>
        <a class="footer-link" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="py-2.5">{site.address.short}</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 border-t border-card-dark-2 pt-4 text-[0.9375rem]">
      <p>© [Year] {site.name}</p>
      <a class="footer-link" href="/privacy">Privacy Policy</a>
      <a class="footer-link" href="/accessibility">Accessibility</a>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--on-dark);
    align-self: flex-start;
  }
  .footer-link:hover { color: var(--white); }
</style>
