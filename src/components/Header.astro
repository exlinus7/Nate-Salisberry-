---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
const onContact = isCurrent('/contact');
---
<header class="site-header border-b border-line bg-white" data-nav="bar">
  <div class="header-row container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
    <a href="/" class="brand flex min-w-0 flex-1 items-center gap-3 text-plum-900 no-underline hover:text-plum-900">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-violet-600">
        <Icon name="logo" color="#FFFFFF" />
      </span>
      <span class="brand-name font-heading text-[1.1875rem] leading-tight font-bold ph:text-[1.375rem]">{site.name}</span>
    </a>

    <button
      type="button"
      class="menu-toggle min-h-11 items-center gap-2 rounded-full border-2 border-plum-900 px-4 font-semibold"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <Icon name="menu" size={20} class="icon-open" />
      <Icon name="close" size={20} class="icon-close hidden" />
      <span>Menu</span>
    </button>

    <nav id="main-nav" aria-label="Main" class="main-nav">
      <ul class="m-0 flex list-none p-0 text-[1.0625rem] font-semibold">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="nav-link flex min-h-11 items-center text-plum-900 no-underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/contact"
        aria-current={onContact ? 'page' : undefined}
        class:list={['nav-cta btn btn-sm', onContact ? 'btn-dark' : 'btn-primary']}
      >
        Get Free Guidance
      </a>
    </nav>
  </div>
</header>

<!-- Fit check, run before first paint: show the one-row menu bar only when every item fits beside the logo
     (depends on screen width AND the A/A+/A++ text size); otherwise fall back to the Menu button. -->
<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    var brand = header.querySelector('.brand');
    var navEl = header.querySelector('.main-nav');
    function fit() {
      if (window.innerWidth < 1024) { header.setAttribute('data-nav', 'menu'); return; }
      header.setAttribute('data-nav', 'bar');
      var wrapped = navEl.getBoundingClientRect().top > brand.getBoundingClientRect().top + 8;
      if (wrapped) header.setAttribute('data-nav', 'menu');
    }
    fit();
    window.__wmFitNav = fit;
    var queued = false;
    window.addEventListener('resize', function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; fit(); });
    }, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    new MutationObserver(fit).observe(document.documentElement, { attributes: true, attributeFilter: ['data-text-size'] });
  })();
</script>

<style>
  /* Default (phones, tablets, or when the bar doesn't fit): Menu button + drop-down list */
  .menu-toggle { display: inline-flex; }
  .main-nav { display: none; width: 100%; }
  .main-nav.open { display: block; }
  .main-nav ul { flex-direction: column; }
  .main-nav li + li { border-top: 1px solid var(--line); }
  .nav-link { min-height: 3rem; border-bottom: 3px solid transparent; }
  .nav-link:hover { color: var(--violet-600); }
  .nav-link[aria-current='page'] { color: var(--violet-600); border-bottom-color: var(--violet-600); }
  .nav-cta { margin: 0.75rem 0 0.5rem; }

  /* One-row bar: only from 1024px and only while data-nav="bar" (the fit check above decides) */
  @media (min-width: 64rem) {
    .site-header[data-nav='bar'] { position: sticky; top: 0; z-index: 40; }
    .site-header[data-nav='bar'] .brand { flex: none; }
    .site-header[data-nav='bar'] .menu-toggle { display: none; }
    .site-header[data-nav='bar'] .brand-name { font-size: 1.25rem; }
    .site-header[data-nav='bar'] .main-nav { display: flex; width: auto; align-items: center; gap: 1.25rem; }
    .site-header[data-nav='bar'] .main-nav ul { flex-direction: row; flex-wrap: nowrap; gap: 1.25rem; font-size: 1rem; }
    .site-header[data-nav='bar'] .main-nav li + li { border-top: 0; }
    .site-header[data-nav='bar'] .nav-link { min-height: 2.75rem; white-space: nowrap; }
    .site-header[data-nav='bar'] .nav-cta { margin: 0; padding-inline: 1.25rem; white-space: nowrap; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('main-nav');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
    toggle?.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle?.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  // Close the drop-down with Escape, and reset it if the layout switches back to the one-row bar
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  if (header) {
    new MutationObserver(() => { if (header.dataset.nav === 'bar') setOpen(false); }).observe(header, { attributes: true, attributeFilter: ['data-nav'] });
  }
</script>
