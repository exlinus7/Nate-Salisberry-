---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, telHref, smsHref, bookingHref } from '../data/site';
import cities from '../data/cities.json';

const methods = [
  { href: telHref, icon: 'phone', title: 'Call us', detail: `${site.phoneDisplay} · ${site.hours}`, track: 'call_click' },
  { href: smsHref, icon: 'chat', title: 'Send a text', detail: 'Prefer texting? So do lots of busy families.', track: 'text_click' },
  { href: bookingHref, icon: 'calendar', title: 'Book a call time', detail: 'Pick a time that works for you.' },
  { href: `mailto:${site.email}`, icon: 'mail', title: 'Email', detail: site.email },
] as const;
---
<BaseLayout
  title="Contact Us"
  description={`Talk with a WiseMove senior living advisor. Call, text, book a time or send a request; we reply within ${site.responseTime}. Always free, no pressure.`}
>
  <section class="bg-lavender-50 pt-16 pb-22 ph:pt-18">
    <div class="container-site grid items-start gap-14 lg:grid-cols-2">
      <div class="flex flex-col gap-6">
        <p class="eyebrow">Contact us</p>
        <h1>Let's talk. It's free, and there's no pressure.</h1>
        <p class="text-xl text-muted">Reach out however feels easiest. An advisor will get back to you within {site.responseTime}, often the same day.</p>
        <ul class="m-0 flex list-none flex-col gap-3.5 p-0">
          {methods.map((m) => (
            <li>
              <a href={m.href} data-track={'track' in m ? m.track : undefined} class="flex items-center gap-4 rounded-[1.125rem] bg-white px-5.5 py-4.5 text-plum-900 no-underline hover:text-plum-900 hover:shadow-[var(--shadow-card)]">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-violet-600"><Icon name={m.icon} size={22} color="#FFFFFF" /></span>
                <span class="min-w-0">
                  <span class="block font-semibold">{m.title}</span>
                  <span class="block [overflow-wrap:anywhere] text-muted">{m.detail}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="consultation" class="rounded-[1.75rem] bg-white p-6 shadow-[var(--shadow-card)] sm:p-9">
        <form
          data-lead-form="consultation"
          data-success="consult-success"
          action={site.formEndpoint}
          method="post"
          novalidate
          class="flex flex-col gap-4.5"
          aria-labelledby="consult-h"
        >
          <input type="hidden" name="form" value="Contact page consultation" />
          <input type="hidden" name="topic" id="consult-topic" value="family" />
          <h2 id="consult-h" class="text-[1.75rem]">Request a free consultation</h2>
          <p class="text-[0.9375rem] text-muted">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field">
              <label for="c-name">Your name <span aria-hidden="true">*</span></label>
              <input id="c-name" name="name" type="text" class="input" autocomplete="name" required data-label="your name" aria-describedby="c-name-error" />
              <p id="c-name-error" class="field-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="c-phone">Phone <span aria-hidden="true">*</span></label>
              <input id="c-phone" name="phone" type="tel" class="input" autocomplete="tel" inputmode="tel" required data-validate="phone" aria-describedby="c-phone-help c-phone-error" />
              <p id="c-phone-help" class="field-help">Any format is fine</p>
              <p id="c-phone-error" class="field-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="field">
            <label for="c-email">Email <span class="field-optional">(optional)</span></label>
            <input id="c-email" name="email" type="email" class="input" autocomplete="email" aria-describedby="c-email-error" />
            <p id="c-email-error" class="field-error" aria-live="polite"></p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field">
              <label for="c-who">Who needs care?</label>
              <select id="c-who" name="who" class="input">
                <option>My parent</option>
                <option>My spouse or partner</option>
                <option>Myself</option>
                <option>A friend or relative</option>
                <option>I represent a community or organization</option>
              </select>
            </div>
            <div class="field">
              <label for="c-zip">Preferred area or ZIP <span class="field-optional">(optional)</span></label>
              <input id="c-zip" name="area" type="text" class="input" autocomplete="postal-code" />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="field">
              <label for="c-care">Type of care</label>
              <select id="c-care" name="care_type" class="input">
                <option>Not sure yet</option>
                <option>Assisted Living</option>
                <option>Memory Care</option>
                <option>Long-Term Care</option>
              </select>
            </div>
            <div class="field">
              <label for="c-when">Timeline</label>
              <select id="c-when" name="timeline" class="input">
                <option>As soon as possible</option>
                <option>1–3 months</option>
                <option>3+ months</option>
                <option>Just researching</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="c-notes">Tell us a little about the situation <span class="field-optional">(optional)</span></label>
            <textarea id="c-notes" name="notes" rows="4" class="input"></textarea>
          </div>

          <div class="field">
            <label for="c-reach">Best way to reach you</label>
            <select id="c-reach" name="contact_preference" class="input">
              <option>Phone call</option>
              <option>Text message</option>
              <option>Email</option>
            </select>
          </div>

          <p data-form-error class="field-error" role="alert"></p>
          <button type="submit" class="btn btn-primary btn-block text-lg font-bold">Send my request</button>
          <p class="flex items-center gap-2 text-[0.9375rem] text-muted">
            <Icon name="lock" size={18} />
            Your information is private. We never sell it or share it without your permission.
          </p>
        </form>

        <div id="consult-success" role="status" hidden class="flex flex-col items-start gap-3.5">
          <div class="flex size-16 items-center justify-center rounded-full bg-lavender-50">
            <Icon name="check" size={32} color="#5B3F8C" strokeWidth={2.4} />
          </div>
          <h2 tabindex="-1" data-success-focus class="text-[1.75rem] outline-none">Thank you. Your request is on its way.</h2>
          <p class="text-muted">An advisor will be in touch within {site.responseTime}. If it's urgent, call us now at <a href={telHref} data-track="call_click">{site.phoneDisplay}</a>.</p>
          <p class="text-muted">While you wait, our free <a href="/resources#checklist">Tour Checklist</a> can help you prepare.</p>
          <button type="button" data-form-reset class="min-h-11 border-0 bg-transparent py-2.5 font-semibold text-violet-700">← Back to the form</button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-18" aria-labelledby="office-h">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div class="media-ph h-64 sm:h-80">[MAP: office location / service area]</div>
      <div class="flex flex-col gap-3">
        <h2 id="office-h" class="text-[2rem]">Our office</h2>
        <address class="text-muted not-italic">{site.address.street}<br />{site.address.cityStateZip}</address>
        <p class="text-muted">We meet families at our office, in their home, at the hospital, or by video, whatever is easiest.</p>
        <p class="font-semibold">
          Serving:{' '}
          {cities.map((c, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/areas/${c.slug}`}>{c.name}</a>
            </>
          ))}
          {' · '}<a href="/areas">All areas</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "Become a partner" links here with ?topic=partner — preselect the right option.
  if (new URLSearchParams(location.search).get('topic') === 'partner') {
    const who = document.getElementById('c-who') as HTMLSelectElement | null;
    const topic = document.getElementById('consult-topic') as HTMLInputElement | null;
    if (who) who.value = 'I represent a community or organization';
    if (topic) topic.value = 'partner';
  }
</script>
