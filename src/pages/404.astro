---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, telHref } from '../data/site';
---
<BaseLayout title="Page not found" description="Sorry, we couldn't find that page." noindex>
  <section class="bg-lavender-50 py-20 ph:py-28">
    <div class="container-site flex max-w-[45rem] flex-col items-center gap-5 text-center">
      <p class="eyebrow">Page not found</p>
      <h1>Sorry, we couldn't find that page.</h1>
      <p class="lead">The link may be old or mistyped. We're still happy to help: call us, or head back to the homepage.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={telHref} data-track="call_click" class="btn btn-cta">Call {site.phoneDisplay}</a>
        <a href="/" class="btn btn-outline">Go to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
